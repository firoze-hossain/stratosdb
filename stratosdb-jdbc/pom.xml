<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.stratosdb</groupId>
        <artifactId>stratosdb-parent</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>stratosdb-jdbc</artifactId>
    <packaging>jar</packaging>

    <name>StratosDB JDBC Driver</name>
    <description>Official pure-Java Type 4 JDBC Driver for StratosDB distributed hybrid relational database</description>
    <url>https://github.com/firoze-hossain/stratosdb</url>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <developers>
        <developer>
            <id>firoze-hossain</id>
            <name>Firoze Hossain</name>
            <email>firoze.hossain@outlook.com</email>
            <url>https://github.com/firoze-hossain</url>
        </developer>
    </developers>

    <scm>
        <connection>scm:git:https://github.com/firoze-hossain/stratosdb.git</connection>
        <developerConnection>scm:git:git@github.com:firoze-hossain/stratosdb.git</developerConnection>
        <url>https://github.com/firoze-hossain/stratosdb</url>
        <tag>HEAD</tag>
    </scm>

    <dependencies>
        <!--
          Test-only: stratosdb-core and stratosdb-network are only used by integration tests to
          spin up in-memory test servers. At runtime, stratosdb-jdbc is 100%
          self-contained with zero server or storage dependencies.
        -->
        <dependency>
            <groupId>com.stratosdb</groupId>
            <artifactId>stratosdb-core</artifactId>
            <version>1.0.0-SNAPSHOT</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.stratosdb</groupId>
            <artifactId>stratosdb-network</artifactId>
            <version>1.0.0-SNAPSHOT</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <!--
          Test-only: a real, permanent regression test drives this driver
          through a real HikariCP pool (see StratosDriverTest's own
          "connectionSurvivesRealHikariCpPoolSetup" test) - added after a
          real, end-to-end DBNavigator integration test found that a real
          connection pool's own standard setup calls (setReadOnly() in
          particular) were never exercised by any test using this driver
          directly via DriverManager, and the driver threw
          SQLFeatureNotSupportedException for it, which would have broken
          every real pool-based consumer of this driver silently until
          someone actually tried one.
        -->
        <dependency>
            <groupId>com.zaxxer</groupId>
            <artifactId>HikariCP</artifactId>
            <version>5.1.0</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-source-plugin</artifactId>
                <executions>
                    <execution>
                        <id>attach-sources</id>
                        <goals>
                            <goal>jar-no-fork</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
                <configuration>
                    <doclint>none</doclint>
                    <quiet>true</quiet>
                </configuration>
                <executions>
                    <execution>
                        <id>attach-javadocs</id>
                        <goals>
                            <goal>jar</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <distributionManagement>
        <snapshotRepository>
            <id>ossrh</id>
            <url>https://s01.oss.sonatype.org/content/repositories/snapshots</url>
        </snapshotRepository>
        <repository>
            <id>ossrh</id>
            <url>https://s01.oss.sonatype.org/service/local/staging/deploy/maven2/</url>
        </repository>
    </distributionManagement>

    <profiles>
        <profile>
            <id>release</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-gpg-plugin</artifactId>
                        <version>3.1.0</version>
                        <executions>
                            <execution>
                                <id>sign-artifacts</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>sign</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.sonatype.plugins</groupId>
                        <artifactId>nexus-staging-maven-plugin</artifactId>
                        <version>1.6.13</version>
                        <extensions>true</extensions>
                        <configuration>
                            <serverId>ossrh</serverId>
                            <nexusUrl>https://s01.oss.sonatype.org/</nexusUrl>
                            <autoReleaseAfterClose>true</autoReleaseAfterClose>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
