#ifndef MyAppVersion
#define MyAppVersion "1.0.0"
#endif

#define MyAppName "StratosDB"
#define MyAppPublisher "StratosDB"
#define MyAppURL "https://github.com/firoze-hossain/stratosdb"
#define MyAppExeName "stratosdb.exe"

[Setup]
AppId={{5A8C98FA-8DE6-4B83-A9DF-0F2B487A3E45}
AppName={#MyAppName}
AppVersion={#MyAppVersion}
AppPublisher={#MyAppPublisher}
AppPublisherURL={#MyAppURL}
AppSupportURL={#MyAppURL}
AppUpdatesURL={#MyAppURL}
DefaultDirName={autopf}\StratosDB
DefaultGroupName={#MyAppName}
DisableProgramGroupPage=yes
OutputBaseFilename=stratosdb-{#MyAppVersion}-windows-setup
Compression=lzma2/ultra64
SolidCompression=yes
WizardStyle=modern
ArchitecturesInstallIn64BitMode=x64compatible
PrivilegesRequired=admin
OutputDir=..\..\dist

[Languages]
Name: "english"; MessagesFile: "compiler:Default.isl"

[Files]
Source: "..\..\dist\stratosdb-win-pkg\*"; DestDir: "{app}"; Flags: ignoreversion recursesubdirs createallsubdirs
Source: "stratosdb.conf"; DestDir: "{app}"; Flags: ignoreversion
Source: "stdsql.bat"; DestDir: "{app}"; Flags: ignoreversion
Source: "stratosdb-service.bat"; DestDir: "{app}"; Flags: ignoreversion
Source: "..\..\packaging\README.txt"; DestDir: "{app}"; Flags: ignoreversion isreadme

[Icons]
Name: "{group}\StratosDB Server"; Filename: "{app}\stratosdb.exe"
Name: "{group}\StratosDB SQL Shell (stdsql)"; Filename: "{cmd}"; Parameters: "/K ""{app}\stdsql.bat"""
Name: "{group}\StratosDB Configuration"; Filename: "notepad.exe"; Parameters: """{app}\stratosdb.conf"""
Name: "{group}\Uninstall StratosDB"; Filename: "{uninstallexe}"
Name: "{autodesktop}\StratosDB SQL Shell"; Filename: "{cmd}"; Parameters: "/K ""{app}\stdsql.bat"""; Tasks: desktopicon

[Tasks]
Name: "desktopicon"; Description: "{cm:CreateDesktopIcon}"; GroupDescription: "{cm:AdditionalIcons}"; Flags: unchecked

[Registry]
Root: HKLM; Subkey: "SYSTEM\CurrentControlSet\Control\Session Manager\Environment"; \
    ValueType: expandsz; ValueName: "Path"; ValueData: "{olddata};{app}"; \
    Check: NeedsAddPath(ExpandConstant('{app}'))

[Run]
Filename: "{app}\stratosdb-service.bat"; Parameters: "install"; Description: "Register StratosDB Windows Service"; Flags: runhidden; Check: ShouldInstallService
Filename: "{app}\stratosdb-service.bat"; Parameters: "start"; Description: "Start StratosDB Service immediately"; Flags: runhidden; Check: ShouldInstallService

[UninstallRun]
Filename: "{app}\stratosdb-service.bat"; Parameters: "remove"; Flags: runhidden

[Code]
var
  ConfigPage: TInputQueryWizardPage;
  OptionsPage: TInputOptionWizardPage;

procedure InitializeWizard;
begin
  ConfigPage := CreateInputQueryPage(wpSelectDir,
    'Database Configuration',
    'Specify port and data directory settings for StratosDB',
    'These settings determine how client applications connect to your StratosDB instance.');
  ConfigPage.Add('Database Port (PostgreSQL wire protocol):', False);
  ConfigPage.Add('Data Directory:', False);
  ConfigPage.Values[0] := '6582';
  ConfigPage.Values[1] := ExpandConstant('{commonappdata}\StratosDB\data');

  OptionsPage := CreateInputOptionPage(ConfigPage.ID,
    'Server & Service Options',
    'Configure server operational mode and background service',
    'Select options for StratosDB startup and service registration:',
    False, False);
  OptionsPage.Add('Enable Multi-Database Cluster Mode (Recommended, PostgreSQL-compatible)');
  OptionsPage.Add('Register StratosDB as an automatic Windows Service');
  OptionsPage.Values[0] := True;
  OptionsPage.Values[1] := True;
end;

function NextButtonClick(CurPageID: Integer): Boolean;
var
  PortVal: Integer;
begin
  Result := True;
  if CurPageID = ConfigPage.ID then
  begin
    PortVal := StrToIntDef(Trim(ConfigPage.Values[0]), -1);
    if (PortVal < 1) or (PortVal > 65535) then
    begin
      MsgBox('Please enter a valid port number between 1 and 65535.', mbError, MB_OK);
      Result := False;
    end;
  end;
end;

function ShouldInstallService: Boolean;
begin
  Result := OptionsPage.Values[1];
end;

procedure CurStepChanged(CurStep: TSetupStep);
var
  ConfFile: String;
  Lines: TArrayOfString;
  ClusterVal: String;
  DataDirVal: String;
begin
  if CurStep = ssPostInstall then
  begin
    ConfFile := ExpandConstant('{app}\stratosdb.conf');
    if OptionsPage.Values[0] then
      ClusterVal := 'true'
    else
      ClusterVal := 'false';

    DataDirVal := ConfigPage.Values[1];
    ForceDirectories(DataDirVal);

    SetArrayLength(Lines, 10);
    Lines[0] := '# StratosDB Configuration File';
    Lines[1] := '# Generated by StratosDB Windows Setup';
    Lines[2] := 'port=' + Trim(ConfigPage.Values[0]);
    Lines[3] := 'data_directory=' + DataDirVal;
    Lines[4] := 'cluster=' + ClusterVal;
    Lines[5] := 'buffer_pool_size=1024';
    Lines[6] := 'sync_wal=true';
    Lines[7] := 'max_connections=100';
    Lines[8] := 'autovacuum_interval_ms=0';
    Lines[9] := 'slow_query_threshold_ms=-1';
    SaveStringsToFile(ConfFile, Lines, False);
  end;
end;

function NeedsAddPath(Param: string): boolean;
var
  OrigPath: string;
begin
  if not RegQueryStringValue(HKEY_LOCAL_MACHINE,
    'SYSTEM\CurrentControlSet\Control\Session Manager\Environment',
    'Path', OrigPath)
  then begin
    Result := True;
    exit;
  end;
  Result := Pos(';' + Param + ';', ';' + OrigPath + ';') = 0;
end;
