<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.stratosdb.server</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Applications/StratosDB.app/Contents/MacOS/stratosdb</string>
        <string>--config</string>
        <string>/usr/local/etc/stratosdb/stratosdb.conf</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/usr/local/var/log/stratosdb/stdout.log</string>
    <key>StandardErrorPath</key>
    <string>/usr/local/var/log/stratosdb/stderr.log</string>
    <key>SoftResourceLimits</key>
    <dict>
        <key>NumberOfFiles</key>
        <integer>65536</integer>
    </dict>
</dict>
</plist>
