#!/bin/bash
# ==============================================================================
# StratosDB Interactive Setup & Configuration Utility
# Reconfigure database port, storage directory, cluster mode, and systemd service.
# ==============================================================================

set -e

CONF_FILE="/etc/stratosdb/stratosdb.conf"
DEFAULT_PORT="6582"
DEFAULT_DATADIR="/var/lib/stratosdb/data"
DEFAULT_CLUSTER="true"

# Ensure root privileges
if [ "$(id -u)" -ne 0 ]; then
    echo "Error: stratosdb-setup must be run as root (use sudo)." >&2
    exit 1
fi

echo "================================================================="
echo "               StratosDB Configuration Setup                     "
echo "================================================================="
echo "Configuring StratosDB database server settings."
echo ""

# Read current values if config exists
CUR_PORT="$DEFAULT_PORT"
CUR_DATADIR="$DEFAULT_DATADIR"
CUR_CLUSTER="$DEFAULT_CLUSTER"

if [ -f "$CONF_FILE" ]; then
    VAL_PORT=$(grep -E '^port=' "$CONF_FILE" | cut -d'=' -f2 | tr -d '[:space:]')
    VAL_DATADIR=$(grep -E '^data_directory=' "$CONF_FILE" | cut -d'=' -f2 | tr -d '[:space:]')
    VAL_CLUSTER=$(grep -E '^cluster=' "$CONF_FILE" | cut -d'=' -f2 | tr -d '[:space:]')
    [ -n "$VAL_PORT" ] && CUR_PORT="$VAL_PORT"
    [ -n "$VAL_DATADIR" ] && CUR_DATADIR="$VAL_DATADIR"
    [ -n "$VAL_CLUSTER" ] && CUR_CLUSTER="$VAL_CLUSTER"
fi

# 1. Port
read -r -p "Database Port [$CUR_PORT]: " INPUT_PORT
INPUT_PORT="${INPUT_PORT:-$CUR_PORT}"

# Validate port number
if ! [[ "$INPUT_PORT" =~ ^[0-9]+$ ]] || [ "$INPUT_PORT" -lt 1 ] || [ "$INPUT_PORT" -gt 65535 ]; then
    echo "Invalid port '$INPUT_PORT'. Using default $DEFAULT_PORT."
    INPUT_PORT="$DEFAULT_PORT"
fi

# 2. Data Directory
read -r -p "Data Directory [$CUR_DATADIR]: " INPUT_DATADIR
INPUT_DATADIR="${INPUT_DATADIR:-$CUR_DATADIR}"

# 3. Cluster Mode
read -r -p "Enable Multi-Database Cluster Mode (y/n) [$( [ "$CUR_CLUSTER" = "true" ] && echo "y" || echo "n" )]: " INPUT_CLUSTER
case "${INPUT_CLUSTER,,}" in
    y|yes) NEW_CLUSTER="true" ;;
    n|no)  NEW_CLUSTER="false" ;;
    *)     NEW_CLUSTER="$CUR_CLUSTER" ;;
esac

# Create directory and user if needed
if ! getent group stratosdb >/dev/null 2>&1; then
    groupadd --system stratosdb
fi
if ! getent passwd stratosdb >/dev/null 2>&1; then
    useradd --system --gid stratosdb --home /var/lib/stratosdb --no-create-home --shell /bin/false stratosdb
fi

mkdir -p "$INPUT_DATADIR"
mkdir -p /var/log/stratosdb
mkdir -p /etc/stratosdb

chown -R stratosdb:stratosdb "$INPUT_DATADIR"
chmod 700 "$INPUT_DATADIR"
chown -R stratosdb:stratosdb /var/log/stratosdb
chown root:stratosdb /etc/stratosdb
chmod 775 /etc/stratosdb

# Write configuration
cat <<EOF > "$CONF_FILE"
# StratosDB Configuration File
# Generated by stratosdb-setup on $(date)

port=$INPUT_PORT
data_directory=$INPUT_DATADIR
cluster=$NEW_CLUSTER

buffer_pool_size=1024
sync_wal=true
max_connections=100
autovacuum_interval_ms=0
slow_query_threshold_ms=-1
EOF

chown root:stratosdb "$CONF_FILE"
chmod 664 "$CONF_FILE"

echo ""
echo "Configuration saved to $CONF_FILE:"
echo "  - Port:           $INPUT_PORT"
echo "  - Data Directory: $INPUT_DATADIR"
echo "  - Cluster Mode:   $NEW_CLUSTER"
echo ""

# Manage service if systemd is present
if [ -d /run/systemd/system ]; then
    read -r -p "Restart StratosDB systemd service now? (y/n) [y]: " RESTART_SVC
    RESTART_SVC="${RESTART_SVC:-y}"
    if [[ "${RESTART_SVC,,}" =~ ^(y|yes)$ ]]; then
        systemctl daemon-reload
        systemctl restart stratosdb 2>/dev/null || systemctl start stratosdb 2>/dev/null || true
        echo "Service restarted. Status: $(systemctl is-active stratosdb 2>/dev/null || echo 'unknown')"
    fi
fi

echo ""
echo "Setup complete! You can connect using:"
echo "  stdsql -h localhost -p $INPUT_PORT -U anyuser -d anydb"
echo "or standard psql / JDBC client."
